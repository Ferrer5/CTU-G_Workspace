
# Django settings
DJANGO_SECRET_KEY=change-me

# MySQL settings
DB_NAME=ctug_workspace_db
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_HOST=localhost
DB_PORT=3306

# Email (SMTP settings are used when DEBUG is False)
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=webmaster@localhost

# Set to false only for local development without signup email verification
REQUIRE_EMAIL_VERIFICATION=True
